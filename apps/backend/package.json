{
  "name": "@aeris/backend",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "node --loader tsx ./src/server.ts",
    "build": "tsc",
    "start": "node ./dist/server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src",
    "type-check": "tsc --noEmit"
